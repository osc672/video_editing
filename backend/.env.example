# ---------------------------------------------------------------- database --
# XAMPP MySQL. Use port 3307 on this machine (3306 is the XAMPP default).
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/ai_video_editor

# -------------------------------------------------------------------- auth --
# Change this to a long random string before deploying.
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------- uploads --
MAX_UPLOAD_MB=600

# ----------------------------------------------------------------- whisper --
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PROMPT=High-converting social media reel. Professional discussion about digital marketing, performance marketing, business growth, leads, conversion, sales, campaigns, client revenue, ROI, One Digital, Vijayawada.

# ----------------------------------------------------------- effect engine --
# Path to the cloned claude-video-effects repo.
EFFECTS_PATH=./vendor/effects
# Leave blank to auto-detect vendor/effects/.venv/Scripts/python.exe (Windows)
# or vendor/effects/.venv/bin/python (macOS / Linux).
EFFECTS_PYTHON=
# 1080 = default, 2160 = 4K (much slower)
EFFECTS_WIDTH=1080
RENDER_TIMEOUT_SECONDS=900

# ------------------------------------------------------------------ queue --
MAX_GLOBAL_RENDERS=3
RENDER_WORKERS=2

# ------------------------------------------------------------------- server --
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------- cleanup --
CLEANUP_AFTER_HOURS=24
